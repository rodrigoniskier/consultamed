# Public browser credentials for Supabase.
# The anon key is designed for frontend use; authorization must be enforced by RLS.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Never place SUPABASE_SERVICE_ROLE_KEY, database passwords or private API keys
# in VITE_* variables: Vite embeds them in the browser bundle.
